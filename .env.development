# Development Environment Variables
# Copy this to .env and fill in real values

# Environment mode
RAG_ENVIRONMENT=development

# Generation and embedding provider (NVIDIA-only)
# Sign up at https://www.nvidia.com/en-us/ai for an API key
RAG_NVIDIA_API_KEY=your_nvidia_api_key

# Storage (REQUIRED - Pinecone is the only supported backend)
# Sign up at https://www.pinecone.io for a free serverless index
RAG_PINECONE_API_KEY=your_pinecone_api_key
RAG_PINECONE_INDEX_NAME=your_index_name

# Postgres dedup index (optional - Supabase project "inteliai-rag").
# Without this set, ingestion falls back to the old full-Pinecone-scan dedup
# check. Get the connection string from: Supabase dashboard -> Project
# Settings -> Database -> Connection string (use the "Session pooler" URI,
# and fill in the DB password you set when creating the project -- it isn't
# retrievable via the API/MCP for security).
# RAG_SUPABASE_DB_URL=postgresql://postgres.jkirjunoobnwxapbpfiq:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# API Keys (optional for development)
# Format: "key1:admin,key2:reader" (comma-separated, colon-separated role)
# RAG_API_KEYS=dev-key:admin

# CORS (optional)
# RAG_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug token (optional - enables GET /debug/retrieval endpoint)
# RAG_DEBUG_TOKEN=dev-debug-token-123

# Chunking strategy
RAG_CHUNKING_STRATEGY=recursive

# Frontend expects API at:
VITE_API_URL=http://localhost:8000

# LangSmith (optional - eval run tracing, https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=inteliai-eval
